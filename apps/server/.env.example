PORT=3001
DATABASE_PATH=./data/agent-console.db
LLM_PROVIDER=mock
LLM_BASE_URL=https://your-gateway.example.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_MS=120000
LLM_RETRY_BASE_DELAY_MS=1000
LLM_MAX_CONTEXT_TOKENS=16000
LLM_MAX_HISTORY_MESSAGES=80
CORS_ORIGIN=http://localhost:5173
APPROVAL_TIMEOUT_MS=600000

# Optional guardrails for the built-in http_request tool.
# Empty means any http(s) host is allowed. Supports exact hosts and *.example.com patterns.
HTTP_TOOL_ALLOWED_HOSTS=
HTTP_TOOL_TIMEOUT_MS=10000
HTTP_TOOL_MAX_RESPONSE_BYTES=524288
